{
  "id": "page",
  "label": "Page",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": ""
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "placeholder": "",
          "allowTargetBlank": true,
          "single": "heading1"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "page_hero": {
              "type": "SharedSlice"
            },
            "headline": {
              "type": "SharedSlice"
            },
            "video_band": {
              "type": "SharedSlice"
            },
            "sector_feature": {
              "type": "SharedSlice"
            },
            "sector_cards": {
              "type": "SharedSlice"
            },
            "statement_band": {
              "type": "SharedSlice"
            },
            "full_width_image": {
              "type": "SharedSlice"
            },
            "quote_slider": {
              "type": "SharedSlice"
            },
            "client_logos": {
              "type": "SharedSlice"
            },
            "our_plan": {
              "type": "SharedSlice"
            },
            "cta_block": {
              "type": "SharedSlice"
            },
            "lead_statement": {
              "type": "SharedSlice"
            },
            "leadership": {
              "type": "SharedSlice"
            },
            "phase_bubbles": {
              "type": "SharedSlice"
            },
            "phase_slider": {
              "type": "SharedSlice"
            },
            "phase_detail": {
              "type": "SharedSlice"
            },
            "project_list": {
              "type": "SharedSlice"
            },
            "contact_card": {
              "type": "SharedSlice"
            },
            "employee_application": {
              "type": "SharedSlice"
            },
            "intake_form": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {
            "width": 2400,
            "height": 1260
          },
          "thumbnails": []
        }
      }
    }
  }
}
